{
  "name": "{{ project_slug }}",
  "private": true,
  "type": "module",
  "scripts": {
{%- if frontend == 'vite' %}
    "dev": "concurrently \"npm:server\" \"npm:vite\"",
    "vite": "vite",
    "build": "vite build",
    "preview": "npm run build && npm run server",
{%- else %}
    "dev": "npm run server",
{%- endif %}
    "server": "PHP_CLI_SERVER_WORKERS=4 php -S localhost:8888 -t public_html server.php",
    "format": "prettier --write \"{{ 'src/**/*.{js,css}' if frontend == 'vite' else 'public_html/assets/**/*.{js,css}' }}\" \"*.{js,md}\" && stylelint \"{{ 'src/**/*.css' if frontend == 'vite' else 'public_html/assets/**/*.css' }}\" --fix && vendor/bin/ecs check --fix",
    "format:check": "prettier --check \"{{ 'src/**/*.{js,css}' if frontend == 'vite' else 'public_html/assets/**/*.{js,css}' }}\" \"*.{js,md}\" && stylelint \"{{ 'src/**/*.css' if frontend == 'vite' else 'public_html/assets/**/*.css' }}\" && vendor/bin/ecs check"
  },
  "devDependencies": {
{%- if frontend == 'vite' %}
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
{%- endif %}
    "prettier": "^3.10.1",
{%- if frontend == 'vite' %}
    "prettier-plugin-tailwindcss": "^0.8.1",
{%- endif %}
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
{%- if frontend == 'vite' %},
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vite-plugin-kirby": "^6.0.0"
{%- endif %}
  }
}
