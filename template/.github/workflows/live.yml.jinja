name: LIVE Deploy website on push

on:
  push:
    branches: ["live"]

jobs:
  deploy:
    uses: slothiestudio/kirby-workflows/.github/workflows/deploy.yml@v1.1.0
    with:
      environment: Live
      php-version: "{{ php_version }}"
{%- if frontend == 'vite' %}
      node-build: true
{%- endif %}
